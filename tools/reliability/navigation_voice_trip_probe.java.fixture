package com.transiva.app;
import android.os.*;import android.location.*;import android.view.*;import org.json.*;import java.util.*;
class VoiceTripProbe{
 static int checks;static void check(boolean ok,String text){if(!ok)throw new AssertionError(text);checks++;System.out.println("PASS "+text);}
 static String last(){List<String> text=android.speech.tts.TextToSpeech.spoken;return text.isEmpty()?"":text.get(text.size()-1);}
 static JSONObject turn(String type,String modifier,double at)throws Exception{return new JSONObject().put("type",type).put("modifier",modifier).put("distance_from_start",at);}
 static Location fix(double lat,double lng,float accuracy){Location l=new Location("gps");l.setLatitude(lat);l.setLongitude(lng);l.setAccuracy(accuracy);return l;}
 public static void main(String[] args)throws Exception{
  android.app.Activity host=new android.app.Activity();android.speech.tts.Voice low=new android.speech.tts.Voice(new Locale("id","ID"),200,100,false),high=new android.speech.tts.Voice(new Locale("id","ID"),500,200,false),cloud=new android.speech.tts.Voice(new Locale("id","ID"),600,0,true);android.speech.tts.TextToSpeech.voices.clear();Collections.addAll(android.speech.tts.TextToSpeech.voices,low,high,cloud);android.speech.tts.TextToSpeech.spoken.clear();
  NavigationVoiceController voice=new NavigationVoiceController(host);Handler.flush();voice.resumed(true);check(android.speech.tts.TextToSpeech.selected==high,"highest-quality installed local Indonesian voice is preferred over a network voice");
  SystemClock.now=100000;voice.route("slow");voice.speak(1,198,"Belok kiri",false,8);check(last().equals("Setelah 200 meter, belok kiri."),"slow-speed early turn is rounded to two hundred meters");int count=android.speech.tts.TextToSpeech.spoken.size();SystemClock.now+=5000;voice.speak(1,195,"Belok kiri",false,8);check(android.speech.tts.TextToSpeech.spoken.size()==count,"GPS oscillation cannot repeat an early turn");SystemClock.now+=5000;voice.speak(1,20,"Belok kiri",false,8);check(last().equals("Belok kiri."),"near-turn prompt is a direct natural action without an inaccurate distance");
  voice.route("fast");SystemClock.now+=5000;voice.speak(1,498,"Belok kanan",false,20);check(last().equals("Setelah 500 meter, belok kanan."),"high-speed early turn is rounded to five hundred meters");voice.route("late-fix");SystemClock.now+=5000;voice.speak(1,95,"Belok kiri",false,8);check(last().equals("Setelah 100 meter, belok kiri."),"navigation opened late never claims an incorrect two-hundred-meter distance");
  voice.route("stop");SystemClock.now+=5000;voice.speak(2,199,"Anda akan tiba di persinggahan",true,20,false);check(last().equals("Setelah 200 meter, Anda akan tiba di persinggahan."),"stop approach uses two hundred meters even at high speed");SystemClock.now+=5000;count=android.speech.tts.TextToSpeech.spoken.size();voice.speak(2,10,"Anda akan tiba di persinggahan",true,1,false);check(android.speech.tts.TextToSpeech.spoken.size()==count,"unconfirmed proximity cannot claim arrival");voice.speak(2,10,"Anda telah tiba di persinggahan",true,1,true);check(last().equals("Anda telah tiba di persinggahan."),"confirmed stop arrival speaks exactly once");
  check(NavigationSpeechText.arrival(turn("arrive","left",100),"delivery",false,Double.NaN,Double.NaN).equals("Tujuan Anda berada di sebelah kiri"),"provider arrival side produces a left-side destination phrase");check(NavigationSpeechText.arrival(turn("arrive","right",100),"delivery",false,Double.NaN,Double.NaN).endsWith("kanan"),"provider right-side destination is preserved");check(NavigationSpeechText.arrival(turn("arrive","",100),"delivery",false,Double.NaN,Double.NaN).endsWith("depan"),"missing destination side stays neutral");JSONObject geometric=turn("arrive","",100).put("lat",-.8).put("lng",120).put("bearing_before",0);check(NavigationSpeechText.side(geometric,-.8,120.0002).equals("kanan"),"clear lateral target offset can resolve right side geometrically");check(NavigationSpeechText.side(geometric,-.8,120.00001).isEmpty(),"tiny lateral offset cannot invent a destination side");check(NavigationSpeechText.side(geometric,-.8,120.002).isEmpty(),"remote off-road target cannot invent a destination side");
  voice.route("after-turn");SystemClock.now=200000;NavigationInstructionController guidance=new NavigationInstructionController(new android.widget.TextView(),"delivery");guidance.setVoice(new NavigationGuidanceVoice(voice,()->true,()->8));JSONArray steps=new JSONArray().put(turn("depart","straight",0)).put(turn("turn","left",200)).put(turn("turn","right",1500)).put(turn("arrive","left",3000));guidance.update(steps,0,false);check(last().contains("200 meter")&&last().contains("kiri"),"departure step cannot hide the upcoming actionable turn");SystemClock.now+=10000;guidance.update(steps,180,false);SystemClock.now+=5000;guidance.update(steps,215,false);check(last().equals("Terus lurus sejauh 1,3 kilometer."),"passing a turn announces the route distance to the next turn");count=android.speech.tts.TextToSpeech.spoken.size();SystemClock.now+=5000;guidance.update(steps,220,false);check(android.speech.tts.TextToSpeech.spoken.size()==count,"post-turn cruise instruction is not repeated per GPS refresh");
  voice.route("destination");SystemClock.now+=5000;guidance.setTarget("delivery",-.8,120);guidance.update(new JSONArray().put(turn("arrive","right",1000)),800,false);check(last().equals("Setelah 200 meter, tujuan Anda berada di sebelah kanan."),"arrival controller speaks natural destination-side approach");voice.route("waypoint");SystemClock.now+=5000;guidance.setTarget("waypoint_2",-.8,120);guidance.update(new JSONArray().put(turn("arrive","",1000)),800,false);check(last().contains("200 meter")&&last().contains("persinggahan"),"waypoint mode speaks persinggahan rather than final delivery");voice.close();
  SystemClock.now=500000;TripButtonsProbe trip=new TripButtonsProbe();trip.order=new JSONObject().put("delivery_lat",-.8).put("delivery_lng",120).put("pickup_lat",-.81).put("pickup_lng",120);trip.tripArrivalFix=fix(-.8003,120,5);trip.refreshButtons();check(trip.arrivedDeliveryBtn.isEnabled(),"arrival unlock uses fresh precise GPS even while the filtered icon is still over 200m away");int enables=trip.arrivedDeliveryBtn.enabledWrites,hides=trip.arrivedDeliveryBtn.hiddenWrites;for(int i=0;i<20;i++)trip.refreshButtons();check(trip.arrivedDeliveryBtn.enabledWrites==enables&&trip.arrivedDeliveryBtn.hiddenWrites==hides,"actual Trip refresh never disables or hides an unchanged arrival swipe");
  trip.tripArrivalFix=fix(-.801,120,5);trip.refreshButtons();check(trip.arrivedDeliveryBtn.isEnabled(),"small boundary GPS noise retains an already-unlocked arrival swipe");trip.tripArrivalFix=fix(-.802,120,5);trip.refreshButtons();check(!trip.arrivedDeliveryBtn.isEnabled(),"moving clearly outside arrival area disables confirmation again");trip.tripArrivalFix=fix(-.8003,120,5);trip.refreshButtons();trip.updatingStatus=true;trip.refreshButtons();check(!trip.arrivedDeliveryBtn.isEnabled(),"pending status request still prevents duplicate arrival submissions");trip.updatingStatus=false;trip.state="arrived_pickup";trip.refreshButtons();check(trip.startDeliveryBtn.isEnabled()&&trip.arrivedDeliveryBtn.getVisibility()==View.GONE,"atomic button update still enforces the proper order phase");
  SystemClock.now+=16000;check(trip.trustedArrivalFix()==null,"stale raw GPS is not reused as fresh arrival proof");trip.tripArrivalFix=fix(-.8,120,60);check(trip.trustedArrivalFix()==null,"weak GPS does not override accepted arrival coordinates");trip.tripArrivalFix=fix(-.8,120,Float.NaN);check(trip.trustedArrivalFix()==null,"non-finite accuracy cannot unlock arrival");
  trip.pendingTripRender=true;trip.tripInteraction(true,true);trip.tripInteraction(false,true);trip.tripInteraction(true,false);Handler.flush();check(trip.renders==0,"polling render stays deferred while either map or swipe interaction remains active");trip.tripInteraction(false,false);Handler.flush();check(trip.renders==1&&!trip.pendingTripRender,"ending the last interaction applies one latest pending UI refresh");
  TripButtonsProbe stops=new TripButtonsProbe();
  JSONObject stop1=new JSONObject().put("sequence",1).put("status","pending").put("latitude",-.8).put("longitude",120).put("address","Stop pertama");
  JSONObject stop2=new JSONObject().put("sequence",2).put("status","pending").put("latitude",-.805).put("longitude",120).put("address","Stop kedua");
  stops.order=new JSONObject().put("status","on_delivery").put("source","orders").put("delivery_lat",-.81).put("delivery_lng",120).put("ecosystem",new JSONObject().put("waypoints",new JSONArray().put(stop2).put(stop1)));
  stops.tripArrivalFix=fix(-.8003,120,5);stops.refreshButtons();
  check(stops.waypointBtn.isEnabled()&&stops.arrivedDeliveryBtn.getVisibility()==View.GONE&&stops.dockHint.text.contains("Persinggahan 1"),"main dock prioritizes first pending stop even when payload is unsorted");
  stops.waypointArrivalBusy=true;stops.refreshButtons();check(!stops.waypointBtn.isEnabled(),"pending stop arrival prevents duplicate swipe submission");stops.waypointArrivalBusy=false;
  stop1.put("status","arrived");stops.refreshButtons();check(stops.dockHint.text.contains("Persinggahan 2")&&!stops.waypointBtn.isEnabled(),"confirmed stop advances main dock to next stop and its own distance gate");
  stops.tripArrivalFix=fix(-.8051,120,5);stops.refreshButtons();check(stops.waypointBtn.isEnabled(),"fresh nearby GPS unlocks the second stop");
  stops.tripArrivalFix=fix(-.8051,120,60);stops.refreshButtons();check(!stops.waypointBtn.isEnabled(),"imprecise GPS cannot confirm a stop");stops.tripArrivalFix=fix(-.8051,120,5);
  stop2.put("status","arrived");stops.refreshButtons();check(stops.waypointBtn.getVisibility()==View.GONE&&stops.arrivedDeliveryBtn.getVisibility()==View.VISIBLE,"final delivery swipe returns after all stops are arrived");
  stops.tripArrivalFix=fix(-.8101,120,5);stops.refreshButtons();check(stops.arrivedDeliveryBtn.isEnabled(),"final arrival uses final destination GPS rather than a previous stop");
  stops.tripStateFresh=false;stops.refreshButtons();check(!stops.arrivedDeliveryBtn.isEnabled(),"reopened trip waits for server synchronization before enabling swipe");
  stops.tripStateFresh=true;stops.tripLastSync=SystemClock.now-16001;stops.refreshButtons();check(!stops.arrivedDeliveryBtn.isEnabled(),"expired trip snapshot cannot enable an arrival action");
  stops.tripLastSync=SystemClock.now;stops.refreshButtons();check(stops.arrivedDeliveryBtn.isEnabled(),"fresh server snapshot restores arrival action without recreating the page");
  stop1.put("status","pending");stops.order.put("source","pickup_orders");stops.refreshButtons();check(stops.waypointBtn.getVisibility()==View.GONE&&stops.arrivedDeliveryBtn.getVisibility()==View.VISIBLE,"pickup orders retain their own delivery action without ride waypoint controls");
  stops.order.put("source","orders").put("status","cancelled");stops.state="cancelled";stops.refreshButtons();check(stops.waypointBtn.getVisibility()==View.GONE&&stops.arrivedDeliveryBtn.getVisibility()==View.GONE&&stops.finishBtn.getVisibility()==View.GONE,"cancelled trip cannot expose an arrival or completion swipe");
  NavigationTripScrollView page=new NavigationTripScrollView(host);NavigationGestureContainer map=new NavigationGestureContainer(host);map.parent=page;page.child=map;map.childUnblocks=true;final boolean[] ancestor={false};page.parent=value->ancestor[0]=value;check(!page.onInterceptTouchEvent(new MotionEvent(0,30,150)),"page recognizes a gesture beginning inside the map");map.dispatchTouchEvent(new MotionEvent(0));map.dispatchTouchEvent(new MotionEvent(2));check(page.blocked&&ancestor[0],"SDK child cannot re-enable parent scroll interception during a map drag");check(!page.onInterceptTouchEvent(new MotionEvent(2,30,200)),"Trip ScrollView cannot steal a continuing map drag");map.dispatchTouchEvent(new MotionEvent(5));check(ancestor[0],"pinch pointer-down preserves map gesture ownership");map.dispatchTouchEvent(new MotionEvent(1));page.onInterceptTouchEvent(new MotionEvent(1));check(!ancestor[0],"map touch-up releases enclosing page scrolling");page.onInterceptTouchEvent(new MotionEvent(0,30,500));check(page.onInterceptTouchEvent(new MotionEvent(2,30,550)),"drag outside the map still scrolls the Trip page normally");map.dispatchTouchEvent(new MotionEvent(0));map.dispatchTouchEvent(new MotionEvent(3));check(!ancestor[0],"cancelled map gesture releases every parent");
  SystemClock.now=900000;Location recent=fix(-.8,120,5);check(NavigationGuidanceVoice.fresh(recent),"fresh precise GPS can authorize a speech prompt");SystemClock.now+=6000;check(!NavigationGuidanceVoice.fresh(recent),"cached six-second-old GPS cannot trigger a late turn announcement");
  System.out.println("NAVIGATION VOICE/TRIP: "+checks+" checks PASS");System.exit(0);
 }
}
