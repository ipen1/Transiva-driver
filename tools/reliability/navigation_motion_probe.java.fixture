package com.transiva.app;
import org.json.*;import java.util.*;import java.lang.reflect.*;import java.io.*;import android.os.*;import android.location.*;import android.view.Choreographer;import com.transiva.app.driver.data.*;import java.util.concurrent.*;
public class MotionProbe{
 static int checks;static void check(boolean b,String s){if(!b)throw new AssertionError(s);checks++;System.out.println("PASS "+s);}
 static JSONObject order(double lat)throws Exception{return new JSONObject().put("order_id","A").put("source","orders").put("status","on_delivery").put("pickup_lat",-.8).put("pickup_lng",120).put("delivery_lat",lat).put("delivery_lng",120);}
 static void drain()throws Exception{for(int i=0;i<80;i++){Handler.flush();Thread.sleep(3);}}
 static void set(Object o,String name,Object value)throws Exception{Field f=o.getClass().getDeclaredField(name);f.setAccessible(true);f.set(o,value);}
 static Location loc(double lat,double lng,float speed){Location l=new Location("gps");l.setLatitude(lat);l.setLongitude(lng);l.setSpeed(speed);l.setBearing(0);return l;}
 static JSONObject badRoute()throws Exception{return new JSONObject().put("code","Ok").put("transiva_navigation",new JSONObject().put("requested_profile","car").put("used_profile","car")).put("routes",new JSONArray().put(new JSONObject().put("distance",556).put("duration",60).put("geometry",new JSONObject().put("coordinates",new JSONArray().put(new JSONArray().put(120).put(-.795)).put(new JSONArray().put(120).put(-.79)))).put("legs",new JSONArray())));}
 static class CountedArray extends JSONArray {volatile int ui,io;public Writer write(Writer w,int factor,int indent)throws JSONException {if(Thread.currentThread().getName().equals("main"))ui++;else io++;return super.write(w,factor,indent);}}
 static NavigationMotionInterpolator model(){NavigationMotionInterpolator m=new NavigationMotionInterpolator();m.offer(1000,-.8,120,359,0,10,5,true,1);m.offer(2000,-.79991,120,1,10,10,5,true,1);return m;}
 public static void main(String[] args)throws Exception{
 NavigationMotionInterpolator m=model();check(m.sample(2000).progress==0,"new GPS point starts from current pose instead of teleporting");check(m.sample(2500).progress>2&&m.sample(2500).progress<8,"pose moves between GPS samples");check(Math.abs(NavigationMotionInterpolator.delta(0,m.sample(2500).bearing))<2,"heading crosses north by shortest angular path");
 for(int fps:new int[]{20,30,60}){m=model();double prior=0,maxStep=0;int moving=0;for(int i=0;i<=fps;i++){double p=m.sample(2000+i*1000/fps).progress;check(p>=prior-1e-8&&p<=10.0001,"monotone bounded pose "+fps+"fps frame "+i);if(p>prior)moving++;maxStep=Math.max(maxStep,p-prior);prior=p;}check(moving>=fps-1&&maxStep<1.6,"continuous per-frame movement at "+fps+"fps");check(Math.abs(prior-10)<.001,"same final position at "+fps+"fps");}
 m=model();m.offer(3000,-.79991,120,180,10,0,5,true,1);check(Math.abs(NavigationMotionInterpolator.delta(1,m.sample(4000).bearing))<2,"stationary route matching jitter cannot rotate the vehicle");
 m=model();double end=m.sample(3000).progress;check(m.sample(100000).progress==end,"missing GPS never causes indefinite vehicle prediction");m.offer(3000,-.79991,120,1,9,0,5,true,1);check(m.sample(4000).progress>=end,"small GPS regression cannot pull marker backwards");
 m=model();m.rendered(2500,-.79995,120.00002);m.offer(2500,-.79994,120.00003,90,0,8,5,true,2);check(NavigationGeometry.meters(m.sample(2500).lat,m.sample(2500).lng,-.79995,120.00002)<.01,"reroute starts from actually rendered pose");check(!m.sample(2600).onRoute,"reroute never applies old progress to new geometry");
 List<double[]> shape=Arrays.asList(new double[]{-.8,120},new double[]{-.799,120},new double[]{-.799,120.001});List<Double> cum=Arrays.asList(0d,111d,222d);NavigationGeometry.Point point=NavigationGeometry.at(shape,cum,166.5);check(Math.abs(point.lat+.799)<1e-8&&Math.abs(point.lng-120.0005)<1e-8,"interpolated road progress follows the bend rather than cutting its corner");
 for(long cadence:new long[]{16,33,50}){Choreographer.clear();final int[] frames={0};NavigationFrameController c=new NavigationFrameController(new Handler(Looper.getMainLooper()),cadence,()->frames[0]++);c.start();for(int i=0;i<120;i++)Choreographer.pulse(1000000000L+i*8333333L);int expected=(int)Math.min(60,Math.round(1000d/cadence))+1;check(Math.abs(frames[0]-expected)<=2,"display callback retains cadence at "+cadence+"ms on 120Hz");c.stop();int old=frames[0];Choreographer.pulse(3000000000L);check(frames[0]==old,"paused frame controller stops at "+cadence+"ms");}
 double[] angles=new double[3];int j=0;for(int fps:new int[]{20,30,60}){NavigationCameraController c=new NavigationCameraController(new NavigationCompatibilityProfile());org.maplibre.android.maps.MapLibreMap map=new org.maplibre.android.maps.MapLibreMap();SystemClock.now=1000;c.update(map,-.8,120,0,36,false,true);for(int i=1;i<=fps;i++){SystemClock.now=1000+i*1000/fps;c.update(map,-.8,120,90,36,false,false);}angles[j++]=map.position.bearing;}check(Math.abs(angles[0]-angles[2])<.3&&Math.abs(angles[1]-angles[2])<.3,"camera heading smoothing is independent of rendering FPS");
 org.maplibre.android.maps.Style style=new org.maplibre.android.maps.Style();NavigationVehicleController icon=new NavigationVehicleController(new android.app.Activity(),"motor");icon.install(style,-.8,120);icon.update(-.799,120.001,25);check(style.layer.angle==25,"viewport icon rotation follows vehicle relative to camera");JSONObject feature=new JSONObject(style.source.json);check(feature.getJSONObject("geometry").getJSONArray("coordinates").getDouble(0)==120.001,"vehicle coordinate publication preserves longitude latitude order");
 SystemClock.now=100000;DriverTripActivityLayer2 trip=new DriverTripActivityLayer2();trip.order=order(-.79);TripVehicleMotionController tm=new TripVehicleMotionController(trip);tm.active(true);tm.offer(loc(-.8,120,10));Choreographer.pulse(100000000000L);SystemClock.now=101000;tm.offer(loc(-.79991,120,10));Choreographer.pulse(101000000000L);double begin=trip.driverMarker.position.latitude;int updates=trip.driverMarker.updates;for(int i=1;i<=30;i++){SystemClock.now=101000+i*1000/30;Choreographer.pulse(SystemClock.now*1000000L);}check(begin<-.79990&&trip.driverMarker.position.latitude>begin&&trip.driverMarker.updates-updates>20,"actual Trip marker receives intermediate positions instead of one GPS jump");tm.active(false);updates=trip.driverMarker.updates;Choreographer.pulse(103000000000L);check(trip.driverMarker.updates==updates,"paused Trip stops all marker movement callbacks");tm.close();
 HostMotionProbe mainHost=new HostMotionProbe();mainHost.order=order(-.79);mainHost.map=new Object();mainHost.setRoutePoints(new JSONArray().put(new JSONArray().put(-.8).put(120)).put(new JSONArray().put(-.79).put(120)));SmoothLocationEngine filter=new SmoothLocationEngine(2000);SystemClock.now=200000;Location first=loc(-.8,120,10);mainHost.handleNavigationLocationFix(first,filter.offer(first));mainHost.animateTowardLatestFix();int initialRenders=mainHost.renders;SystemClock.now=201000;Location second=loc(-.79991,120,10);mainHost.handleNavigationLocationFix(second,filter.offer(second));check(mainHost.renders==initialRenders,"actual navigation GPS callback never publishes a competing map frame");mainHost.animateTowardLatestFix();double initialLat=mainHost.displayLat;for(int i=1;i<=30;i++){SystemClock.now=201000+i*1000/30;mainHost.animateTowardLatestFix();}check(mainHost.displayLat>initialLat&&mainHost.renders-initialRenders>20,"actual navigation animation publishes intermediate map poses");check(mainHost.routeFixes==2,"render interpolation never fabricates extra GPS/reroute fixes");mainHost.currentBearing=90;SystemClock.now=202100;Location stopped=loc(-.79991,120,0);stopped.setBearing(270);mainHost.handleNavigationLocationFix(stopped,filter.offer(stopped));check(mainHost.currentBearing==90,"stationary GPS heading jitter cannot spin navigation camera");
 // The two regressions reproduced during the previous review must now stay fixed.
 DriverNavigationActivityLayer2 host=new DriverNavigationActivityLayer2();host.order=order(-.79);NavigationSessionStore.clear(host);NavigationSessionStore.stopped=false;
 DriverApiClient.Reply old=new DriverApiClient.Reply(new JSONObject().put("order",order(-.79)),true);DriverApiClient.replies.add(old);NavigationLiveRouteController nav=new NavigationLiveRouteController(host);nav.resumed(true);Handler.flush();check(old.entered.await(2,TimeUnit.SECONDS),"old poll is in flight before target revision changes");host.order=order(-.77);nav.targetChanged();old.release.countDown();drain();check(host.targetLat()==-.77,"stale state response cannot rewind a new target on the same order");nav.close();
 NavigationSessionStore.stopped=false;NavigationSessionStore.foreground=false;NavigationGuidanceService service=new NavigationGuidanceService();service.onCreate();JSONObject snap=new JSONObject().put("order",order(-.79).toString()).put("mode","delivery").put("profile","car").put("lat",-.79).put("lng",120).put("key","A");set(service,"snapshot",snap);set(service,"key","A");set(service,"last",loc(-.8,120,10));set(service,"fixAt",SystemClock.now);DriverConnectionRepository.replies.clear();DriverConnectionRepository.replies.add(new DriverConnectionRepository.Reply(badRoute().toString(),false));Method request=service.getClass().getDeclaredMethod("request");request.setAccessible(true);request.invoke(service);drain();NavigationRecoveryPolicy recovery=(NavigationRecoveryPolicy)get(service,"recovery");check(recovery.needed()&&!recovery.due(SystemClock.now)&&recovery.due(SystemClock.now+2000),"unusable successful route schedules bounded retry instead of a request burst");service.onDestroy();
 DriverNavigationActivityLayer2 endedHost=new DriverNavigationActivityLayer2();endedHost.order=order(-.79).put("status","finished");NavigationSessionStore.stopped=false;NavigationLiveRouteController endedNav=new NavigationLiveRouteController(endedHost);endedNav.resumed(true);check(endedHost.finishing&&NavigationSessionStore.stopped,"finished order cannot start a new foreground navigation session");endedNav.close();
 // Large route serialization must not execute on the caller/UI thread.
 android.app.Activity context=new android.app.Activity();NavigationSessionStore.stopped=false;CountedArray points=new CountedArray();for(int i=0;i<12000;i++)points.put(new JSONArray().put(-.8+i*.000001).put(120));StableRouteEngine.Result r=new StableRouteEngine.Result(points,1200,120,new JSONArray());JSONObject route=NavigationSessionStore.route(r);check(NavigationSessionStore.route(r)==route,"route checkpoint body is reused without repeated UI encoding");
 for(int i=0;i<150;i++)NavigationSessionStore.save(context,new JSONObject().put("owner",NavigationSessionStore.identity(context)).put("saved",System.currentTimeMillis()).put("key","sequence-"+i).put("route",route));
 for(int i=0;i<500&&!context.getSharedPreferences("nav_checkpoint_v2",0).getString("route","").contains("sequence-149");i++)Thread.sleep(3);
 check(points.ui==0&&points.io>0,"large geometry encoding occurs only on checkpoint IO worker");check(context.getSharedPreferences("nav_checkpoint_v2",0).getString("route","").contains("sequence-149"),"coalesced checkpoints persist the newest snapshot");NavigationSessionStore.clear(context);NavigationSessionStore.stopped=false;NavigationSessionStore.save(context,new JSONObject().put("owner",NavigationSessionStore.identity(context)).put("saved",System.currentTimeMillis()).put("key","new-session"));
 for(int i=0;i<500&&!context.getSharedPreferences("nav_checkpoint_v2",0).getString("route","").contains("new-session");i++)Thread.sleep(2);check(context.getSharedPreferences("nav_checkpoint_v2",0).getString("route","").contains("new-session"),"new checkpoint wins when it immediately follows clear");
 System.out.println("NAVIGATION MOTION: "+checks+" checks PASS");System.exit(0);
 }
 static Object get(Object o,String name)throws Exception{Field f=o.getClass().getDeclaredField(name);f.setAccessible(true);return f.get(o);}
}
