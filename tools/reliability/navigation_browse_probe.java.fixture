package com.transiva.app;
import android.os.*;import android.location.Location;import java.util.*;import java.lang.reflect.*;import org.json.*;
public class BrowseProbe{
 static int checks;static void check(boolean ok,String text){if(!ok)throw new AssertionError(text);checks++;System.out.println("PASS "+text);}
 static Location loc(double lat,double lng,float speed){Location l=new Location("gps");l.setLatitude(lat);l.setLongitude(lng);l.setSpeed(speed);l.setBearing(0);return l;}
 static JSONArray bend()throws Exception{return new JSONArray().put(new JSONArray().put(-.8).put(120)).put(new JSONArray().put(-.79991).put(120)).put(new JSONArray().put(-.79991).put(120.00009));}
 static void set(Object o,String name,Object v)throws Exception{Field f=o.getClass().getDeclaredField(name);f.setAccessible(true);f.set(o,v);}
 static void call(Object o,String name)throws Exception{Method m=o.getClass().getDeclaredMethod(name);m.setAccessible(true);m.invoke(o);}
 public static void main(String[] args)throws Exception{
  SystemClock.now=1000;org.maplibre.android.maps.MapLibreMap map=new org.maplibre.android.maps.MapLibreMap();NavigationCameraController camera=new NavigationCameraController(new NavigationCompatibilityProfile());
  org.maplibre.android.maps.Style style=new org.maplibre.android.maps.Style();HostVehicleProbe vehicle=new HostVehicleProbe();vehicle.map=map;vehicle.vehicleController=new NavigationVehicleController(new android.app.Activity(),"motor");vehicle.vehicleController.install(style,-.8,120);
  int[] gestures={0};camera.bind(map,()->gestures[0]++,vehicle::updateVehicleSource);camera.update(map,-.8,120,45,30,false,true);check(camera.following(),"programmatic camera changes keep vehicle following enabled");
  map.gesture();map.position=new org.maplibre.android.camera.CameraPosition.Builder().target(new org.maplibre.android.geometry.LatLng(-.7,120.2)).zoom(12).bearing(123).tilt(15).build();map.cameraChanged();
  check(!camera.following()&&gestures[0]==1,"user drag zoom or rotation suspends automatic camera following");
  int writes=map.writes;for(int i=0;i<120;i++){SystemClock.now+=17;double bearing=camera.update(map,-.799,120,90,40,false,i==0);check(bearing==123,"browse camera bearing retained frame "+i);}
  check(map.writes==writes&&map.position.zoom==12&&map.position.target.latitude==-.7,"GPS rendering cannot overwrite user pan zoom tilt or rotation");
  check(Math.abs(style.layer.angle-282)<.01,"production icon publication uses actual camera bearing while browsing");JSONArray xy=new JSONObject(style.source.json).getJSONObject("geometry").getJSONArray("coordinates");check(xy.getDouble(0)==120&&xy.getDouble(1)==-.8,"camera gestures never relocate the vehicle marker");
  map.position.bearing=250;map.cameraChanged();check(Math.abs(style.layer.angle-155)<.01,"stationary marker rotates with manual map rotation without a GPS fix");
  camera.restore(map,-.799,120);check(map.writes==writes,"restore and style-ready camera operations respect browse mode");camera.follow(true);camera.update(map,-.799,120,90,40,false,true);check(camera.following()&&map.writes>writes&&map.position.target.latitude==-.799,"recenter resumes following the latest vehicle position");
  for(long cadence:new long[]{1000,2000,3000}){NavigationMotionInterpolator motion=new NavigationMotionInterpolator();motion.offer(1000,-.8,120,0,0,10,5,true,1);motion.offer(1000+cadence,-.79973,120,0,30,10,5,true,1);double earlier=motion.sample(1000+cadence+cadence-200).progress,later=motion.sample(1000+cadence+cadence-50).progress;check(later>earlier&&later<30,"GPS cadence "+cadence+"ms remains moving before next expected fix");check(motion.sample(30000).progress==30,"lost GPS at cadence "+cadence+"ms holds accepted endpoint without extrapolation");}
  HostMotionProbe h=new HostMotionProbe();h.map=new Object();h.setRoutePoints(bend());h.driverLat=-.79991;h.driverLng=120.00009;h.currentSpeedKmh=72;h.lastGpsAccuracyM=5;h.lastFixRealtimeMs=h.motionFixAt=2000;h.motionRevision=h.routeVisualRevision;
  h.vehicleMotion.offer(1000,-.8,120,0,0,20,5,true,h.routeVisualRevision);h.vehicleMotion.offer(2000,-.79991,120.00009,90,20,20,5,true,h.routeVisualRevision);
  SystemClock.now=2250;h.animateTowardLatestFix();check(h.visualRouteProgressMeters<9&&Math.abs(h.snappedBearing)<.01,"actual main navigation does not turn icon before its rendered position reaches the corner");check(h.instructionProgress>19,"instruction progress continues to use accepted GPS rather than delayed visual position");
  SystemClock.now=2600;h.animateTowardLatestFix();check(h.visualRouteProgressMeters>10&&h.snappedBearing>0&&h.snappedBearing<90,"main navigation smooths turn only after reaching the new road segment");
  NavigationRenderedHeading hd=new NavigationRenderedHeading();hd.update(1000,359,true);double north=hd.update(1100,1,true);check(Math.abs(NavigationMotionInterpolator.delta(0,north))<2,"render tangent smoothing takes shortest angle across north");double stopped=hd.update(1200,190,false);check(stopped==north,"stationary tangent noise does not spin the icon");
  SystemClock.now=100000;DriverTripActivityLayer2 trip=new DriverTripActivityLayer2();trip.order=new JSONObject().put("order_id","A").put("status","on_delivery");trip.tripLiveRoutes=new TripLiveRouteController(trip);StableRouteEngine.Result route=new StableRouteEngine.Result(bend(),20,10,new JSONArray());set(trip.tripLiveRoutes,"route",route);call(trip.tripLiveRoutes,"install");
  TripVehicleMotionController tm=new TripVehicleMotionController(trip);tm.active(true);tm.offer(loc(-.8,120,20));android.view.Choreographer.pulse(SystemClock.now*1000000);SystemClock.now=101000;tm.offer(loc(-.79991,120.00009,20));android.view.Choreographer.pulse(SystemClock.now*1000000);SystemClock.now=101250;android.view.Choreographer.pulse(SystemClock.now*1000000);
  check(Math.abs(trip.driverMarker.heading)<.01&&trip.driverMarker.position.latitude<-.79992,"actual Trip marker follows rendered road tangent before corner");check(trip.googleMap.cameraWrites==0,"Trip overview browsing does not cause per-GPS camera resets");trip.tripCameraFollowing=true;tm.recenter();check(trip.googleMap.cameraWrites>0&&trip.googleMap.camera.zoom==17,"Trip recenter enables live vehicle camera");trip.googleMap.camera.bearing=77;trip.googleMap.camera.zoom=16;SystemClock.now=101400;android.view.Choreographer.pulse(SystemClock.now*1000000);check(trip.googleMap.camera.bearing==77&&trip.googleMap.camera.zoom==16,"Trip follow preserves selected camera bearing and zoom");trip.tripCameraFollowing=false;int cameraWrites=trip.googleMap.cameraWrites,markerUpdates=trip.driverMarker.updates;SystemClock.now=101700;android.view.Choreographer.pulse(SystemClock.now*1000000);check(trip.googleMap.cameraWrites==cameraWrites&&trip.driverMarker.updates>markerUpdates,"Trip user browsing detaches camera while vehicle continues along route");tm.close();trip.tripLiveRoutes.close();
  NavigationEtaEstimator eta=new NavigationEtaEstimator();for(int i=1;i<=30;i++)eta.offer(i*1000,10,5,true);double moving=eta.seconds(30000,500,50,1000,100);for(int i=31;i<=60;i++)eta.offer(i*1000,0,5,true);double waiting=eta.seconds(60000,500,50,1000,100);check(waiting>moving&&waiting<240,"confirmed stops add finite elapsed delay to ETA");check(eta.seconds(80000,500,50,1000,100)==50,"stale GPS cannot keep accumulating traffic delay");check(eta.seconds(60000,10,2,1000,100)==2,"stationary delay cannot prevent an arrival ETA from reaching zero");
  for(int i=61;i<=100;i++)eta.offer(i*1000,10,5,true);check(eta.seconds(100000,500,50,1000,100)<waiting,"stationary delay decays when travel resumes");eta.reset();for(int i=1;i<=600;i++)eta.offer(i*1000,0,5,true);check(eta.seconds(600000,500,50,1000,100)<=230,"long parking cannot generate an unbounded ETA");eta.reset();for(int i=1;i<=60;i++)eta.offer(i*1000,0,60,true);check(eta.seconds(60000,500,50,1000,100)==50,"weak accuracy cannot create stationary delay");eta.reset();for(int i=1;i<=60;i++)eta.offer(i*1000,0,5,false);check(eta.seconds(60000,500,50,1000,100)==50,"off-route observations cannot create traffic delay");
  List<double[]> roads=Arrays.asList(new double[]{-.8,120},new double[]{-.799,120},new double[]{-.799,120.00007},new double[]{-.8,120.00007});List<Double> lengths=new ArrayList<>();double total=0;for(int i=0;i<roads.size();i++){if(i>0)total+=NavigationGeometry.meters(roads.get(i-1)[0],roads.get(i-1)[1],roads.get(i)[0],roads.get(i)[1]);lengths.add(total);}
  NavigationGeometry.Projection matched=NavigationGeometry.project(roads,lengths,-.7995,120.000035,Double.NaN,180,5,10);check(Math.abs(matched.bearing-180)<1,"parallel return lanes use reliable heading to resolve equal distances");matched=NavigationGeometry.project(roads,lengths,-.7995,120.000001,Double.NaN,180,5,10);check(Math.abs(matched.bearing)<1,"wrong-way evidence cannot be hidden by snapping to a farther return lane");matched=NavigationGeometry.project(roads,lengths,-.7995,120.000001,Double.NaN,180,60,10);check(Math.abs(matched.bearing)<1,"weak accuracy cannot force a heading-based lane switch");
  NavigationGestureContainer box=new NavigationGestureContainer(new android.app.Activity());final boolean[] blocked={false};box.parent=value->blocked[0]=value;check(box.dispatchTouchEvent(new android.view.MotionEvent(0))&&blocked[0],"nested map drag reaches SDK child and blocks page scrolling");box.dispatchTouchEvent(new android.view.MotionEvent(5));check(blocked[0],"two-finger map gestures keep parent scroll blocked");box.dispatchTouchEvent(new android.view.MotionEvent(1));check(!blocked[0],"touch up releases enclosing page scrolling");box.dispatchTouchEvent(new android.view.MotionEvent(0));box.dispatchTouchEvent(new android.view.MotionEvent(3));check(!blocked[0],"cancelled gesture cannot leave Trip page scrolling locked");box.dispatchTouchEvent(new android.view.MotionEvent(0));box.onDetachedFromWindow();check(!blocked[0],"map rebuild during gesture releases parent scroll ownership");
  System.out.println("NAVIGATION BROWSE: "+checks+" checks PASS");System.exit(0);
 }
}
