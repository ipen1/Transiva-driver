package com.transiva.app;
import org.json.*;import android.os.*;import android.location.*;import java.util.*;import java.lang.reflect.*;import java.util.concurrent.*;import com.transiva.app.driver.data.*;
public class ConsistencyProbe{
 static int checks;static void check(boolean b,String s){if(!b)throw new AssertionError(s);checks++;System.out.println("PASS "+s);}
 static JSONObject order()throws Exception{return new JSONObject().put("order_id","A").put("source","orders").put("status","on_delivery").put("pickup_lat",-.8).put("pickup_lng",120).put("delivery_lat",-.79).put("delivery_lng",120);}
 static JSONObject stop(int n,String state)throws Exception{return new JSONObject().put("sequence",n).put("status",state).put("latitude",-.795+n*.0001).put("longitude",120.001);}
 static JSONObject route(double distance)throws Exception{return new JSONObject().put("code","Ok").put("transiva_navigation",new JSONObject().put("requested_profile","car").put("used_profile","car")).put("routes",new JSONArray().put(new JSONObject().put("distance",distance).put("duration",100).put("geometry",new JSONObject().put("coordinates",new JSONArray().put(new JSONArray().put(120).put(-.8)).put(new JSONArray().put(120).put(-.79)))).put("legs",new JSONArray())));}
 static void drain()throws Exception{for(int i=0;i<80;i++){Handler.flush();Thread.sleep(3);}}
 static Object field(Object a,String f)throws Exception{Field x=a.getClass().getDeclaredField(f);x.setAccessible(true);return x.get(a);}
 static void call(Object a,String method,JSONObject o)throws Exception{Method m=a.getClass().getDeclaredMethod(method,JSONObject.class);m.setAccessible(true);m.invoke(a,o);}
 static Location loc(double lat,double lng,float speed){Location l=new Location("gps");l.setLatitude(lat);l.setLongitude(lng);l.setSpeed(speed);l.setBearing(0);return l;}
 public static void main(String[] args)throws Exception{
 JSONObject o=order();o.put("ecosystem",new JSONObject().put("waypoints",new JSONArray().put(stop(2,"pending")).put(stop(1,"pending"))));
 check(NavigationTargetPolicy.resolve(o,"delivery",0,0).mode.equals("waypoint_1"),"trip and navigation select the first pending stop by sequence");
 o.getJSONObject("ecosystem").getJSONArray("waypoints").getJSONObject(1).put("status","arrived");check(NavigationTargetPolicy.resolve(o,"waypoint_1",1,1).mode.equals("waypoint_2"),"completed stop switches target to next pending stop");
 o.getJSONObject("ecosystem").getJSONArray("waypoints").getJSONObject(0).put("status","arrived");check(NavigationTargetPolicy.resolve(o,"waypoint_2",1,1).lat==-.79,"last completed stop returns to current final destination");
 JSONObject bad=new JSONObject(o.toString()).put("delivery_lat",JSONObject.NULL).put("delivery_lng",JSONObject.NULL);check(!NavigationTargetPolicy.resolve(bad,"waypoint_2",1,1).valid(),"missing final destination cannot reuse an old waypoint");
 check(!NavigationTargetPolicy.same(o,new JSONObject(o.toString()).put("source","pickup_orders")),"same public order code in a different table is isolated");check(NavigationTargetPolicy.terminal(new JSONObject().put("status","cancelled_by_customer")),"customer cancellation ends navigation without changing status");
 o.put("status","driver_accepted");check(NavigationTargetPolicy.resolve(o,"pickup",0,0).mode.equals("pickup"),"pending pickup ignores delivery stop list");check(NavigationTargetPolicy.valid(0,120)&&!NavigationTargetPolicy.valid(0,0),"equator coordinates remain valid but absent zero pair is rejected");
 NavigationRefreshPolicy p=new NavigationRefreshPolicy();p.evaluated(1000,-.8,120);check(!p.due(80000,-.79,120,10,5,1000),"healthy route evaluation waits ninety seconds");check(!p.due(100000,-.7999,120,10,5,1000),"tiny movement cannot produce healthy request churn");check(p.due(100000,-.79,120,10,5,1000),"healthy route evaluates after significant time and travel");check(!p.due(100000,-.79,120,10,60,1000)&&!p.due(100000,-.79,120,0,5,1000),"weak GPS and stopped vehicles do not trigger evaluations");check(p.better(100000,600,500)&&!p.better(100000,600,550),"automatic replacement requires material time benefit");p.manual(100000);check(!p.better(100001,600,100)&&!p.due(100001,-.79,120,10,5,1000),"manual alternative is protected from healthy replacement");
 NavigationRefreshPolicy restored=new NavigationRefreshPolicy();restored.hold(100000,500000);check(restored.manualRemaining(100000)==180000,"persisted manual hold is bounded to three minutes");
 NavigationDeviationDetector detector=new NavigationDeviationDetector();check(detector.offer(1,-.8,120,Double.NaN,10,0,0,100)==NavigationDeviationDetector.Reason.NONE,"invalid accuracy cannot trigger a reroute");
 SmoothLocationEngine smoothing=new SmoothLocationEngine(2000);Location damaged=loc(-.8,120,10);damaged.setAccuracy(Float.NaN);check(smoothing.offer(damaged)==null,"invalid accuracy cannot poison smoothing state");damaged=loc(-.8,120,Float.NaN);check(smoothing.offer(damaged)==null,"invalid speed cannot poison movement state");
 Location recent=loc(-.8,120,10);check(NavigationLocationController.fresh(recent),"fresh accurate GPS may seed navigation");SystemClock.now+=16000;check(!NavigationLocationController.fresh(recent),"old last-known GPS cannot seed initial routing");recent=loc(-.8,120,10);recent.setAccuracy(90);check(!NavigationLocationController.fresh(recent),"poor accuracy location cannot seed initial routing");
 final JSONObject[] current={order()};final int[] updates={0};NavigationOrderSync sync=new NavigationOrderSync(new android.app.Activity(),new NavigationOrderSync.Callback(){public JSONObject currentOrder(){return current[0];}public void updated(JSONObject fresh){updates[0]++;current[0]=fresh;}});
 DriverApiClient.Reply hold=new DriverApiClient.Reply(new JSONObject().put("order",order()),true);DriverApiClient.replies.add(hold);sync.active(true);Handler.flush();check(hold.entered.await(2,TimeUnit.SECONDS),"single navigation state request starts");sync.active(false);hold.release.countDown();drain();check(updates[0]==0,"paused navigation drops late state response");
 DriverApiClient.replies.add(new DriverApiClient.Reply(new JSONObject().put("order",order().put("delivery_lat",-.78)),false));sync.active(true);drain();check(updates[0]==1&&current[0].optDouble("delivery_lat")==-.78,"current state update delivers new destination");
 DriverApiClient.replies.add(new DriverApiClient.Reply(new JSONObject().put("order",order().put("order_id","B")),false));SystemClock.now+=5000;drain();check(updates[0]==1,"mismatched response order cannot change navigation");sync.close();
 DriverTripActivityLayer2 trip=new DriverTripActivityLayer2();trip.order=order();trip.order.put("server_route",new JSONObject().put("route_hash","agreed").put("route",route(1000)));
 TripLiveRouteController live=new TripLiveRouteController(trip);live.active(true);DriverConnectionRepository.replies.add(new DriverConnectionRepository.Reply(route(1000).toString(),false));live.fix(loc(-.8,120,10));drain();check(field(live,"route")!=null&&trip.deliveryPolyline!=null,"transaction snapshot never blocks live trip routing");
 Location moved=loc(-.795,120,10);trip.lastDriverLat=-.795;live.fix(moved);check(trip.tripLiveSummary.text.contains("sisa jalan 0.5"),"trip distance decreases along road geometry");
 trip.order.put("delivery_lat",-.78);DriverConnectionRepository.Reply waiting=new DriverConnectionRepository.Reply(route(2000).toString(),true);DriverConnectionRepository.replies.add(waiting);live.request(false);waiting.entered.await(2,TimeUnit.SECONDS);check(field(live,"route")==null&&trip.deliveryPolyline==null,"changed target immediately clears old active route");live.active(false);waiting.release.countDown();drain();check(field(live,"route")==null,"paused trip cannot apply a late route response");live.close();
 NavigationSessionStore.stopped=false;DriverNavigationActivityLayer2 host=new DriverNavigationActivityLayer2();host.order=order();NavigationLiveRouteController nav=new NavigationLiveRouteController(host);nav.resumed(true);drain();
 Method apply=nav.getClass().getDeclaredMethod("applyOrderState",JSONObject.class,boolean.class);apply.setAccessible(true);apply.invoke(nav,order().put("delivery_lat",-.77),true);check(host.targetLat()==-.77&&host.routePoints.isEmpty(),"foreground state update invalidates old target geometry");
 apply.invoke(nav,order().put("status","finished"),true);check(host.finishing&&NavigationSessionStore.stopped,"finished order stops foreground guidance without mutation");nav.close();
 NavigationSessionStore.stopped=false;NavigationSessionStore.foreground=false;NavigationGuidanceService service=new NavigationGuidanceService();service.onCreate();
 JSONObject snap=new JSONObject().put("order",order().toString()).put("profile","car").put("mode","delivery").put("lat",-.79).put("lng",120).put("key","old-key").put("owner",NavigationSessionStore.identity(service)).put("saved",System.currentTimeMillis());Field sf=service.getClass().getDeclaredField("snapshot");sf.setAccessible(true);sf.set(service,snap);
 call(service,"applyOrderState",order().put("delivery_lat",-.76));check(snap.optDouble("lat")==-.76&&snap.optBoolean("needs_route")&&!snap.has("route"),"background state update changes target and clears stale route");call(service,"applyOrderState",order().put("status","cancelled"));check(service.stopped&&NavigationSessionStore.stopped,"cancelled order stops background guidance without mutation");service.onDestroy();
 check(DriverApiClient.calls<12,"state sync stays bounded without busy-loop polling");
 System.out.println("NAVIGATION CONSISTENCY: "+checks+" checks PASS");System.exit(0);
 }}
