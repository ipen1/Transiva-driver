package com.transiva.app;
import android.os.*;import android.location.*;import android.view.*;import org.json.*;import java.lang.reflect.*;
class ReliabilityProbe{
 static int checks;static void check(boolean ok,String text){if(!ok)throw new AssertionError(text);checks++;System.out.println("PASS "+text);}
 static void set(Object o,String n,Object v)throws Exception{Field f=o.getClass().getDeclaredField(n);f.setAccessible(true);f.set(o,v);}static Object get(Object o,String n)throws Exception{Field f=o.getClass().getDeclaredField(n);f.setAccessible(true);return f.get(o);}static Object call(Object o,String n)throws Exception{Method m=o.getClass().getDeclaredMethod(n);m.setAccessible(true);return m.invoke(o);}
 static JSONObject order()throws Exception{return new JSONObject().put("order_id","A").put("status","on_delivery").put("source","orders").put("pickup_lat",-.8).put("pickup_lng",120).put("delivery_lat",-.76).put("delivery_lng",120);}
 static Location fix(double lat,double lng,float acc,float speed){Location l=new Location("gps");l.setLatitude(lat);l.setLongitude(lng);l.setAccuracy(acc);l.setSpeed(speed);l.setBearing(0);return l;}
 static JSONArray dense()throws Exception{JSONArray a=new JSONArray();for(int i=0;i<=60;i++)a.put(new JSONArray().put(-.8+i*.00045).put(120));return a;}
 static TripLiveRouteController trip(DriverTripActivityLayer2 h)throws Exception{h.order=order();h.lastDriverLat=-.8;h.lastDriverLng=120;TripLiveRouteController t=new TripLiveRouteController(h);t.active(true);set(t,"key",call(t,"currentKey"));set(t,"target",NavigationTargetPolicy.resolve(h.order,"delivery",Double.NaN,Double.NaN));set(t,"route",new StableRouteEngine.Result(dense(),3000,300,new JSONArray()));call(t,"install");t.fix(fix(-.8,120,5,0));return t;}
 public static void main(String[] args)throws Exception{
  SystemClock.now=100000;DriverTripActivityLayer2 h=new DriverTripActivityLayer2();TripLiveRouteController t=trip(h);SystemClock.now+=180000;h.lastDriverLat=-.782;t.fix(fix(-.782,120,5,0));check(!(boolean)get(t,"suspect")&&(double)get(t,"prior")>1900,"Trip reacquires a stopped driver 2km ahead after a three-minute GPS gap");check(t.visualPose(fix(-.782,120,5,0))!=null,"Trip vehicle can snap to the road again without waiting for movement");check(!((NavigationRecoveryPolicy)get(t,"recovery")).needed(),"returning on the same road does not force an unnecessary network reroute");t.close();
  SystemClock.now=500000;h=new DriverTripActivityLayer2();t=trip(h);SystemClock.now+=180000;h.lastDriverLat=-.782;h.lastDriverLng=120.0015;t.fix(fix(-.782,120.0015,60,0));check((boolean)get(t,"reacquiring")&&Double.isNaN((double)get(t,"prior")),"weak first fix after GPS loss keeps global reacquisition pending");SystemClock.now+=1000;t.fix(fix(-.782,120.0015,5,0));check(((NavigationRecoveryPolicy)get(t,"recovery")).needed(),"accurate off-route stationary fix schedules recovery after weak reacquisition");t.close();
  android.app.Activity context=new android.app.Activity();for(DevicePerformanceProfile.UserMode mode:DevicePerformanceProfile.UserMode.values()){DevicePerformanceProfile.selected=mode;NavigationCompatibilityProfile p=NavigationCompatibilityProfile.resolve(context,"auto");check(p.visualFrameMs<=16,"navigation mode "+mode+" targets at least 60Hz callbacks");}
  DevicePerformanceProfile.selected=DevicePerformanceProfile.UserMode.AUTO;for(DevicePerformanceProfile.Tier tier:DevicePerformanceProfile.Tier.values()){DevicePerformanceProfile.detected=tier;check(NavigationCompatibilityProfile.resolve(context,"auto").visualFrameMs<=16,"auto device tier "+tier+" no longer caps navigation at 15-30fps");}
  check(NavigationCompatibilityProfile.normal().visualFrameMs==8&&NavigationCompatibilityProfile.stable().visualFrameMs==16,"high and stable profiles select 120Hz and 60Hz ceilings");
  for(int display:new int[]{60,90,120,144})for(long interval:new long[]{8,16}){Choreographer.clear();int[] rendered={0};NavigationFrameController frame=new NavigationFrameController(new Handler(Looper.getMainLooper()),interval,()->rendered[0]++);frame.start();frame.start();for(int i=0;i<display;i++)Choreographer.pulse(1000000000L+i*1000000000L/display);int expected=(int)Math.min(display,interval==8?120:60);check(Math.abs(rendered[0]-expected)<=2,"single frame owner paces "+expected+" callbacks on "+display+"Hz screen");int previous=rendered[0];Choreographer.pulse(5000000000L);check(rendered[0]==previous+1,"long display stall never replays a backlog of missed frames");frame.stop();previous=rendered[0];Choreographer.pulse(6000000000L);check(rendered[0]==previous,"pause removes pending callbacks on "+display+"Hz screen");}
  NavigationFrameController high=new NavigationFrameController(new Handler(Looper.getMainLooper()),8,()->{});org.maplibre.android.maps.MapView mv=new org.maplibre.android.maps.MapView();high.attachMapView(mv);high.attachMapView(mv);check(mv.fps==120&&mv.calls==1,"MapLibre receives a 120fps renderer ceiling once per map instance");
  context.wm.display.modes=new Display.Mode[]{new Display.Mode(1,1080,2400,60),new Display.Mode(2,1080,2400,90),new Display.Mode(3,1080,2400,120),new Display.Mode(4,1440,3200,120),new Display.Mode(5,1080,2400,144)};NavigationDisplayPolicy.prefer(context,8);check(context.window.params.preferredDisplayModeId==3&&context.window.params.preferredRefreshRate==120,"display request chooses supported 120Hz at the existing resolution");int preferenceWrites=context.window.writes;NavigationDisplayPolicy.prefer(context,8);check(context.window.writes==preferenceWrites,"unchanged display preference does not repeatedly relayout the window");NavigationDisplayPolicy.prefer(context,16);check(context.window.params.preferredDisplayModeId==1,"stable profile requests supported 60Hz without changing resolution");context.wm.display.modes=new Display.Mode[]{new Display.Mode(2,1080,2400,90)};NavigationDisplayPolicy.prefer(context,8);check(context.window.params.preferredDisplayModeId==2,"90Hz hardware is used without inventing a 120Hz display mode");
  SystemClock.now=1000000;HostMotionProbe motion=new HostMotionProbe();motion.map=new Object();motion.order=order();motion.setRoutePoints(dense());motion.driverLat=-.8;motion.driverLng=120;motion.currentSpeedKmh=36;motion.lastFixRealtimeMs=SystemClock.now;motion.animateTowardLatestFix();SystemClock.now+=1000;motion.driverLat=-.79991;motion.lastFixRealtimeMs=SystemClock.now;motion.animateTowardLatestFix();int renders=motion.renders,matches=motion.matches,guidance=motion.guidanceCalls;for(int i=1;i<=120;i++){SystemClock.now=1001000+i*1000/120;motion.animateTowardLatestFix();}check(motion.renders-renders>=115,"production navigation publishes motion across 120 display frames");check(motion.matches==matches,"120 display frames do not repeat raw GPS route matching");check(motion.guidanceCalls-guidance<=11,"guidance and route-line work stay bounded at 10Hz under 120Hz animation");
  org.maplibre.android.maps.Style style=new org.maplibre.android.maps.Style();NavigationVehicleController icon=new NavigationVehicleController(context,"motor");icon.install(style,-.8,120);int sourceWrites=style.source.writes;icon.update(-.8,120,45);icon.update(-.8,120,60);check(style.source.writes==sourceWrites,"camera-only rotation does not rebuild identical vehicle GeoJSON");icon.update(-.799,120,60);check(style.source.writes==sourceWrites+1,"moving vehicle still publishes changed coordinates");
  String token=NavigationGuidanceHealth.begin("session-A","route-A",1000);check(NavigationGuidanceHealth.status(token,"session-A","route-A",1000)==NavigationGuidanceHealth.State.PENDING,"service start is pending until actual foreground promotion");check(!NavigationGuidanceHealth.acknowledge(token,"session-B","route-A",1001),"another login cannot acknowledge this guidance session");String replacement=NavigationGuidanceHealth.begin("session-A","route-B",1100);check(!NavigationGuidanceHealth.acknowledge(token,"session-A","route-A",1200),"stale service callback cannot acknowledge a changed target");check(NavigationGuidanceHealth.acknowledge(replacement,"session-A","route-B",1200),"matching foreground acknowledgement enables readiness");NavigationGuidanceHealth.failed(token);check(NavigationGuidanceHealth.status(replacement,"session-A","route-B",1300)==NavigationGuidanceHealth.State.READY,"old service destruction cannot fail a replacement acknowledgement");NavigationGuidanceHealth.heartbeat(replacement,7000);check(NavigationGuidanceHealth.status(replacement,"session-A","route-B",12000)==NavigationGuidanceHealth.State.READY,"live service heartbeat maintains foreground readiness");check(NavigationGuidanceHealth.status(replacement,"session-A","route-B",14001)==NavigationGuidanceHealth.State.FAILED,"missing service heartbeat expires readiness");
  token=NavigationGuidanceHealth.begin("session-A","route-A",1000);check(NavigationGuidanceHealth.status(token,"session-A","route-A",6001)==NavigationGuidanceHealth.State.FAILED&&!NavigationGuidanceHealth.acknowledge(token,"session-A","route-A",6002),"timed-out startup cannot be revived by a late foreground callback");
  SystemClock.now=2000000;NavigationSessionStore.clear(context);NavigationSessionStore.stopped=false;androidx.core.content.ContextCompat.deny=true;androidx.core.content.ContextCompat.starts=0;DriverNavigationActivityLayer2 nh=new DriverNavigationActivityLayer2();nh.order=order();NavigationLiveRouteController nav=new NavigationLiveRouteController(nh);nav.resumed(true);NavigationOptionsController options=(NavigationOptionsController)get(nav,"options");check(!(boolean)get(nav,"serviceReady")&&options.backgroundFailed,"OS startup denial is reflected in existing navigation controls");SystemClock.now+=1999;call(nav,"checkGuidance");check(androidx.core.content.ContextCompat.starts==1,"startup retries respect initial backoff");SystemClock.now++;call(nav,"checkGuidance");SystemClock.now+=4000;call(nav,"checkGuidance");SystemClock.now+=60000;call(nav,"checkGuidance");check(androidx.core.content.ContextCompat.starts==3,"background startup retry stops after three foreground attempts");nav.resumed(false);int starts=androidx.core.content.ContextCompat.starts;SystemClock.now+=60000;call(nav,"checkGuidance");check(androidx.core.content.ContextCompat.starts==starts,"paused page never launches background retry attempts");
  androidx.core.content.ContextCompat.deny=false;nav.resumed(true);check(!(boolean)get(nav,"serviceReady"),"accepted Android start request is not reported as ready before acknowledgement");NavigationGuidanceService service=new NavigationGuidanceService();service.onCreate();service.onStartCommand(androidx.core.content.ContextCompat.last,0,1);call(nav,"checkGuidance");check((boolean)get(nav,"serviceReady")&&!options.backgroundFailed,"actual successful foreground promotion clears the warning");service.onStartCommand(androidx.core.content.ContextCompat.last,0,2);call(nav,"checkGuidance");check(!service.stopped&&(boolean)get(nav,"serviceReady"),"duplicate service start is idempotent after foreground acknowledgement");service.onDestroy();call(nav,"checkGuidance");check(!(boolean)get(nav,"serviceReady")&&options.backgroundFailed,"service destruction invalidates readiness and restores warning");nav.close();
  SystemClock.now+=100000;NavigationSessionStore.stopped=false;nh=new DriverNavigationActivityLayer2();nh.order=order();nav=new NavigationLiveRouteController(nh);nav.resumed(true);android.app.Service.failPromotion=true;service=new NavigationGuidanceService();service.onCreate();service.onStartCommand(androidx.core.content.ContextCompat.last,0,1);call(nav,"checkGuidance");check(service.stopped&&!(boolean)get(nav,"serviceReady")&&((NavigationOptionsController)get(nav,"options")).backgroundFailed,"foreground promotion exception stops service and remains visible to the user");service.onDestroy();nav.close();android.app.Service.failPromotion=false;
  HostOptionsProbe ui=new HostOptionsProbe();int warnings=android.widget.Toast.shown;ui.guidanceFailure(true);check(ui.sound.text.contains("Latar nonaktif")&&ui.sound.maxLines==3&&ui.sound.description.contains("background belum aktif"),"existing sound control exposes background failure without adding an overlay");ui.guidanceFailure(true);check(android.widget.Toast.shown==warnings+1,"repeated health polling cannot spam the same warning toast");ui.guidanceFailure(false);check(!ui.sound.text.contains("Latar nonaktif")&&ui.sound.maxLines==2,"recovered guidance restores the original compact sound label");
  SystemClock.now=3000000;NavigationSessionStore.stopped=false;nh=new DriverNavigationActivityLayer2();nh.order=order();nav=new NavigationLiveRouteController(nh);nav.resumed(true);StableRouteEngine.Result longRoute=new StableRouteEngine.Result(dense(),3000,300,new JSONArray());set(nav,"current",longRoute);set(nav,"targetKey",call(nav,"key"));nh.setRoutePoints(dense());nh.lastMatchedProgressMeters=0;nav.fix(fix(-.8,120,5,0));SystemClock.now+=180000;nh.driverLat=-.782;nh.driverLng=120.0015;nh.lastFixRealtimeMs=SystemClock.now;nh.lastMatchedProgressMeters=Double.NaN;nav.fix(fix(-.782,120.0015,5,0));check(((NavigationRecoveryPolicy)get(nav,"recovery")).needed(),"foreground navigation can recover an off-route stationary driver after GPS loss");nav.close();
  NavigationSessionStore.foreground=false;NavigationSessionStore.stopped=false;service=new NavigationGuidanceService();service.onCreate();JSONObject background=new JSONObject().put("key","A").put("profile","car").put("route_id","long").put("order",order().toString()).put("mode","delivery").put("lat",-.76).put("lng",120).put("route",NavigationSessionStore.route(longRoute));set(service,"snapshot",background);set(service,"key","A");call(service,"install");set(service,"last",fix(-.8,120,5,0));set(service,"fixAt",SystemClock.now);set(service,"prior",0d);SystemClock.now+=180000;service.onLocationChanged(fix(-.782,120.0015,5,0));check(((NavigationRecoveryPolicy)get(service,"recovery")).needed(),"background guidance can recover an off-route stationary driver after GPS loss");service.onDestroy();
  System.out.println("NAVIGATION RELIABILITY: "+checks+" checks PASS");System.exit(0);
 }
}
